#!/bin/sh
set -eu
case "${XDG_CURRENT_DESKTOP:-}" in
    *KDE*) ;;
    *) echo 'Automatic shortcut registration needs KDE. Assign Alt+K to neutrasearch --spotlight in your desktop shortcut settings.' >&2; exit 1 ;;
esac
if [ $# -eq 0 ]; then
    exec /usr/local/bin/neutrasearch --register-shortcuts
fi
if [ "$1" = --disabled ]; then shift; fi
keys=
for key in "$@"; do
    case "$key" in *[!0-9]*|'') echo 'Invalid shortcut key' >&2; exit 1 ;; esac
    keys="${keys}${keys:+,}$key"
done
entry=neutrasearch-quick-search.desktop
tmp=$(mktemp "${TMPDIR:-/tmp}/neutrasearch-shortcut.XXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM

call() {
    method=$1
    shift
    timeout 5 dbus-send --session --print-reply --dest=org.kde.kglobalaccel /kglobalaccel \
        "org.kde.KGlobalAccel.$method" "$@"
}

for key in "$@"; do
    if ! call getGlobalShortcutsByKey int32:"$key" >"$tmp" 2>&1; then
        echo 'Could not query KDE global shortcut availability.' >&2
        exit 1
    fi
    if ! awk -v entry="$entry" '
        /struct \{/ { field = 0 }
        /^[[:space:]]*string / {
            field++
            if (field == 1 && $2 != "\"_launch\"") conflict = 1
            if (field == 3 && $2 != "\"" entry "\"") conflict = 1
        }
        END { exit conflict }
    ' "$tmp"; then
        echo 'The requested shortcut is already assigned to another application. Previous shortcuts remain active.' >&2
        exit 1
    fi
done
call doRegister array:string:"$entry",_launch,'Neutrasearch Quick Search','Quick file search' >/dev/null
call shortcut array:string:"$entry",_launch,'Neutrasearch Quick Search','Quick file search' >"$tmp"
previous=$(awk '/int32 / { printf "%s%s", separator, $2; separator="," }' "$tmp")
call setShortcut array:string:"$entry",_launch,'Neutrasearch Quick Search','Quick file search' \
    array:int32:"$keys" uint32:4 >/dev/null
call shortcut array:string:"$entry",_launch,'Neutrasearch Quick Search','Quick file search' >"$tmp"
saved=$(awk '/int32 / { print $2 }' "$tmp" | sort -n | tr '\n' ',')
expected=$(printf '%s\n' "$@" | sed '/^$/d' | sort -n | tr '\n' ',')
if [ "$saved" != "$expected" ]; then
    call setShortcut array:string:"$entry",_launch,'Neutrasearch Quick Search','Quick file search' \
        array:int32:"$previous" uint32:4 >/dev/null
    echo 'KDE did not save all shortcuts; previous shortcuts restored.' >&2
    exit 1
fi
call unRegister array:string:neutrasearch-quick-search,_launch,'Neutrasearch Quick Search','Open quick search' >/dev/null
# Qt AltModifier | Key_K. Update the reset-to-default key separately.
call setShortcut array:string:"$entry",_launch,'Neutrasearch Quick Search','Quick file search' \
    array:int32:134217803 uint32:8 >/dev/null
